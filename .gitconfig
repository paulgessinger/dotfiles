[user]
	name = Paul Gessinger
	email = hello@paulgessinger.com
[mergetool]
	keepBackup = true
[push]
	default = simple
[core]
	excludesfile = ~/.gitignore
	editor = nvim
[alias]
	conflicted = !vim +Conflicted
[pull]
	ff = only
[init]
	defaultBranch = main
[rebase]
	updateRefs = true

[include]
  path = ~/dotfiles/delta_themes.gitconfig

[include]
  path = ~/.gitconfig.local
[gitbutler]
	aiModelProvider = lmstudio
	aiLMStudioModelName = openai/gpt-oss-20b
	aiLMStudioEndpoint = http://localhost:1234
	diffLengthLimit = 100000

[delta]
    side-by-side = true
