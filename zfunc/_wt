#compdef wt

# Completion for the `wt` git-worktree helper in .zshrc.
#
# This lives in fpath (via `fpath+=~/.zfunc`) rather than being registered with a
# `compdef` call in .zshrc: compinit rediscovers a `#compdef`-tagged file on every
# run, so it survives compinit running late or more than once. A compdef made from
# .zshrc only survives if whichever plugin owns compinit replays its queue.

local -a branches
branches=(${(f)"$(
  git for-each-ref --format='%(refname:short)' refs/heads refs/remotes/origin 2>/dev/null |
    sed -e 's|^origin/||' -e '/^origin$/d' |
    sort -u
)"})

_describe 'branch' branches
